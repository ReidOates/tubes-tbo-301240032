{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/src/frontend/dist/$1" }
  ],
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "src/frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ]
}